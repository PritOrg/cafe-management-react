# API base URL (must be reachable from the browser)
VITE_API_URL=http://localhost:4969/api/v1

# First-paint brand fallback (before /settings/public responds). Optional —
# the app then applies the tenant's live brand (title, colors, favicon).
VITE_DEFAULT_BRAND_NAME=Restaurant
VITE_DEFAULT_PRIMARY_COLOR=#ff6b35
VITE_DEFAULT_ACCENT_COLOR=#f7931e
