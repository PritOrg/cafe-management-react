{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "lint": "eslint . --ext .js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "knex migrate:latest --knexfile db/knexfile.js",
    "db:deploy": "NODE_ENV=production knex migrate:latest --knexfile db/knexfile.js",
    "db:seed": "knex seed:run --knexfile db/knexfile.js",
    "db:reset": "node scripts/db-reset.js",
    "verify": "npm run lint && npm test"
  },
  "keywords": [],
