# Copy to .env and fill in values. Never commit .env.

# Server
PORT=4969
NODE_ENV=development
JWT_SECRET=
WEB_URL=http://localhost:3000
PUBLIC_DOMAIN=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Databases
# Postgres via Knex (Phase I). Use Neon DATABASE_URL in prod, or local Docker (docker-compose.yml).
DATABASE_URL=postgresql://cafe:cafe@127.0.0.1:5433/cafe
DIRECT_DATABASE_URL=
NEON_BRANCH=
# Legacy Mongo (removed from code; kept only if you still run old tooling)
MONGO_URI=
DB_URI=

# Tenancy
DEFAULT_TENANT_SLUG=cafe1
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Storage: local | firebase
STORAGE_DRIVER=local
PUBLIC_UPLOAD_URL=http://localhost:4969/uploads
FIREBASE_STORAGE_BUCKET=

# Mail (optional; leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
