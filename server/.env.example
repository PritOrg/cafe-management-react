# Copy to .env and fill in values. Never commit .env.

# Server
PORT=4969
NODE_ENV=development
JWT_SECRET=
WEB_URL=http://localhost:3000
PUBLIC_DOMAIN=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Databases
# Postgres via Knex. Use Neon or any Postgres in prod, or local Docker (docker-compose.yml).
DATABASE_URL=postgresql://cafe:cafe@127.0.0.1:5433/cafe
# Optional unpooled URL used only by migrations in production.
DIRECT_DATABASE_URL=
# Optional; db:reset refuses to run when NEON_BRANCH=prod.
NEON_BRANCH=
# Optional fallback connection string, used only if DATABASE_URL is unset.
DB_URI=

# Tenancy
DEFAULT_TENANT_SLUG=cafe1
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Storage: local | cloudinary
# Leave STORAGE_DRIVER empty to auto-detect (cloudinary when the keys below are set, else local).
STORAGE_DRIVER=
PUBLIC_UPLOAD_URL=http://localhost:4969/uploads

# Cloudinary (used when STORAGE_DRIVER=cloudinary, or auto-detected when set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail (optional). Two ways to enable:
#   A) Generic SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
#   B) Brevo SMTP relay (used when SMTP_HOST is empty and BREVO_API_KEY is set):
#      host smtp-relay.brevo.com, login = SMTP_USER / BREVO_SMTP_LOGIN / MAIL_FROM,
#      password = the Brevo SMTP/API key.
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
MAIL_FROM=
